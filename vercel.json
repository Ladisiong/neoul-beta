{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/free",
      "destination": "/free/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/free/",
      "destination": "https://neoul-download.vercel.app/"
    },
    {
      "source": "/free/:path*",
      "destination": "https://neoul-download.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "neoul-beta.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
